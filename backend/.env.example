APP_ENV=development
APP_NAME=LearnGen AI Backend
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
API_V1_PREFIX=/api/v1
SECRET_KEY=learngen-ai-production-super-secret-jwt-key-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=sqlite:///./learngen_ai.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/learngen_ai

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# SMTP Production Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="LearnGen AI Security"
SMTP_TLS=True
SMTP_SSL=False
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

